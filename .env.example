# Copy to .env and supply your own key. Never commit .env.
LOOPBLOX_PROVIDER=freeinference
FREEINFERENCE_API_KEY=
FREEINFERENCE_BASE_URL=https://freeinference.org/v1
FREEINFERENCE_MODEL=deepseek-v4-flash
FREEINFERENCE_TEMPERATURE=0
FREEINFERENCE_MAX_TOKENS=8192

# Select with LOOPBLOX_PROVIDER=opencode_go. Use a Chat Completions model.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=glm-5.1
OPENCODE_GO_TEMPERATURE=0
OPENCODE_GO_MAX_TOKENS=8192

# Required for online judge calls and research post-run Jev analysis.
TYPESAFE_API_KEY=
# Optional absolute virtualenv interpreter path; defaults to the host interpreter.
LOOPBLOX_JEV_PYTHON=

# Default research agent: pinned Linux Codex CLI 0.155.0, using an existing ChatGPT login.
# Required distribution directory containing bin/codex and the stock Code Mode host.
LOOPBLOX_CODEX_BINARY_ROOT=
LOOPBLOX_CODEX_MODEL=gpt-6-astra
LOOPBLOX_CODEX_REASONING_EFFORT=low
# Optional; otherwise $CODEX_HOME/auth.json or ~/.codex/auth.json. Never copy credentials here.
LOOPBLOX_CODEX_AUTH_FILE=
